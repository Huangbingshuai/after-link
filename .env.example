# Copy this file to .env, then fill the blank project-specific values.
# The development-only Docker credentials below match compose.yaml and bind only to localhost.

# LLM provider. Get the API key and base URL from your provider's API console/docs.
# Set OPENAI_BASE_URL and OPENAI_API_BASE to the same base URL.
OPENAI_BASE_URL=
OPENAI_API_BASE=
OPENAI_API_KEY=
VL_MODEL=
LLM_DEFAULT_MODEL=
LLM_DEFAULT_TEMPERATURE=

# MinerU API, used by the document import workflow. Get these from your MinerU API account/docs.
MINERU_BASE_URL=
MINERU_API_TOKEN=

# Local BGE embedding / reranker models. The repo ID is from app/tool/download_bgem3.py;
# set the path fields to the actual model directories on this Mac after downloading them.
BGE_M3_PATH=
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=0
BGE_RERANKER_LARGE=
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=0

# MongoDB, Milvus, MinIO, and Neo4j endpoints started by compose.yaml.
MONGO_ROOT_USERNAME=after_link
MONGO_ROOT_PASSWORD=after_link_mongo_dev
MONGO_URL=mongodb://after_link:after_link_mongo_dev@127.0.0.1:27017/after_link?authSource=admin
MONGO_DB_NAME=after_link

MILVUS_URL=http://127.0.0.1:19530
# If you already have Milvus data, get these exact names from that deployment's .env/config.
# This new local Milvus starts empty, so names for a fresh database need your choice.
CHUNKS_COLLECTION=
ENTITY_NAME_COLLECTION=
ITEM_NAME_COLLECTION=

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=after_link_minio
MINIO_SECRET_KEY=after_link_minio_dev
MINIO_BUCKET_NAME=kb-import-bucket
MINIO_IMG_DIR=images
MINIO_PDF_DIR=pdf_files
MINIO_SECURE=False

NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=after_link_neo4j_dev

# Optional DashScope WebSearch MCP service (Streamable HTTP).
DASHSCOPE_API_KEY=
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
